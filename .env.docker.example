# Copy values from here into your shell environment, a private .env file, or your
# production secret manager. Do not commit real secrets.

# Deployment controls. Keep confirmations at 0 until a tested backup/restore and
# the existing-DB baseline review are recorded on the production change ticket.
COMPOSE_FILE=docker-compose.server.yml
DEPLOY_HEALTH_URL=http://127.0.0.1/api/healthz
DEPLOY_AUDIT_LOG=.deploy-history.log
API_IMAGE=
PRE_DEPLOY_BACKUP_CONFIRMED=0
BASELINE_STAGING_VERIFIED=0
ALLOW_INITIAL_DEPLOY=0

# Persistent infrastructure
DATABASE_URL=
REDIS_URL=

# API / auth
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Comma-separated exact browser origins. Defaults to https://anothermeai.app
# when unset; set explicit development origins outside production.
CORS_ALLOWED_ORIGINS=https://anothermeai.app
DATABASE_CONNECTION_TIMEOUT_MS=3000

# Browser PWA deployment. PWA_ORIGIN is the public browser origin; native EAS
# builds use their own EXPO_PUBLIC_API_BASE_URL settings in artifacts/mobile/eas.json.
PWA_ORIGIN=https://anothermeai.app
PWA_BASE_PATH=/app
EXPO_PUBLIC_API_BASE_URL=https://api.anothermeai.app
EXPO_PUBLIC_CLERK_PROXY_URL=
EXPO_PUBLIC_REOWN_PROJECT_ID=
WALLET_SIGN_IN_DOMAIN=anothermeai.app
WALLET_SIGN_IN_URI=https://anothermeai.app

# LiveKit Cloud or self-hosted LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI features
OPENAI_API_KEY=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@anotherme.app

# Native Android FCM. Put the full service-account JSON on one line or inject it
# through the production secret manager.
FIREBASE_SERVICE_ACCOUNT=

# Production S3/R2/MinIO example. The local docker-compose.yml already sets local
# MinIO defaults, so these are only needed when deploying outside local Docker.
S3_BUCKET=anotherme-objects
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_PUBLIC_ENDPOINT=https://s3.ap-northeast-2.amazonaws.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRIVATE_PREFIX=private
S3_PUBLIC_PREFIXES=public

# Knowledge graph / ontology. Production should override the password with a
# private secret; the compose default is only for internal bootstrap.
NEO4J_URI=neo4j://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1g
NEO4J_PAGECACHE=512m
