# Copy to /etc/anotherme/disk-monitor.env and restrict it to root/operator read.
# Leaving DISK_ALERT_WEBHOOK_URL unset means metrics are kept locally and no
# external alert is delivered.

DISK_MONITOR_PATH=/
DISK_WARN_PERCENT=80
DISK_CRITICAL_PERCENT=90
DISK_WARN_AVAILABLE_BYTES=10737418240
DISK_CRITICAL_AVAILABLE_BYTES=5368709120
DISK_METRIC_RETENTION_DAYS=35
DISK_GROWTH_MAX_SAMPLE_AGE_SECONDS=86400

# Treat this URL as a secret. Configure a dedicated incoming webhook after
# verifying its retention and access policy.
# DISK_ALERT_WEBHOOK_URL=https://alerts.example.invalid/incoming/replace-me
