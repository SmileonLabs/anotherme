{
  email support@anothermeai.app

  # UDP 443 is intentionally not published by the current single-host setup.
  # Do not advertise an unreachable HTTP/3 alternative until UDP is opened and
  # verified end-to-end through the security group and host firewall.
  servers {
    protocols h1 h2
  }
}

(access_observability) {
  log {
    output stdout
    format filter {
      # Never persist credentials, query tokens, cookies or full client IPs.
      request>uri delete
      request>headers delete
      request>remote_ip ip_mask 24 48
      request>client_ip ip_mask 24 48
      wrap json
    }
  }
  log_append <request_path {http.request.uri.path}
  # This value is generated by Caddy. Never copy/log the caller-provided
  # X-Request-Id before API validation.
  log_append <edge_request_id {http.request.uuid}
}

(api_proxy) {
  request_body {
    max_size 30MB
  }

  reverse_proxy app-a:8080 app-b:8080 {
    lb_policy least_conn
    health_uri /api/healthz
    header_up X-Edge-Request-Id {http.request.uuid}
    header_down X-Edge-Request-Id {http.request.uuid}
    header_down +Access-Control-Expose-Headers X-Edge-Request-Id
  }
}

anothermeai.app {
  import access_observability
  header Alt-Svc "clear"

  handle /api/* {
    import api_proxy
  }

  handle /app {
    redir * /app/ 308
  }

  @appAssetPaths path /app/_expo/static/* /app/assets/* /app/favicon.ico
  handle @appAssetPaths {
    root * /srv/app
    uri strip_prefix /app
    encode zstd gzip
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }

  handle_path /app/* {
    root * /srv/app
    encode zstd gzip
    header Cache-Control "no-cache"
    try_files {path} /index.html
    file_server
  }

  @downloadAssetPaths path /downloads/*
  handle @downloadAssetPaths {
    root * /srv/landing
    header Cache-Control "no-store"
    file_server
  }

  @landingAssetPaths path /assets/* /images/* /favicon.svg /apple-touch-icon.png /icon-*.png /manifest.webmanifest /robots.txt /sw.js /anotherme.pdf /opengraph.jpg
  handle @landingAssetPaths {
    root * /srv/landing
    encode zstd gzip
    file_server
  }

  handle {
    root * /srv/landing
    encode zstd gzip
    try_files {path} /index.html
    file_server
  }
}

api.anothermeai.app {
  import access_observability
  header Alt-Svc "clear"
  import api_proxy
}
